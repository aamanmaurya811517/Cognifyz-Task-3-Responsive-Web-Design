<%- include("../partials/head", { title }) %><%- include("../partials/navbar") %>
<main class="form-page"><div class="container"><div class="text-center contact-heading reveal"><span class="eyebrow">Get in touch</span><h1>Let's start a <span>conversation.</span></h1><p class="muted-copy">Have a question about courses or enrollment? We're happy to help.</p></div><div class="row g-4 mt-2">
<div class="col-lg-4 reveal"><div class="contact-panel"><h2>Contact information</h2><p>Reach out through any of these channels.</p><div class="contact-line"><i class="bi bi-envelope-fill"></i><span><small>Email</small><b>support@cognifyz.com</b></span></div><div class="contact-line"><i class="bi bi-telephone-fill"></i><span><small>Phone</small><b>+91 98765 43210</b></span></div><div class="contact-line"><i class="bi bi-geo-alt-fill"></i><span><small>Location</small><b>Lucknow, Uttar Pradesh</b></span></div></div></div>
<div class="col-lg-8 reveal"><div class="form-card"><h2>Send us a message</h2><p class="muted-copy">We usually respond within two working days.</p>
<% if (success) { %><div class="alert alert-success">Your demo message has been submitted successfully.</div><% } %><% if (errors.length) { %><div class="alert alert-danger"><ul class="mb-0"><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %>
<form action="/contact" method="POST" id="contactForm" novalidate><div class="row g-3"><div class="col-md-6"><label class="form-label" for="name">Your name *</label><input class="form-control" id="name" name="name" value="<%= formData.name || '' %>" required minlength="2" placeholder="Your name"></div><div class="col-md-6"><label class="form-label" for="contactEmail">Your email *</label><input class="form-control" type="email" id="contactEmail" name="email" value="<%= formData.email || '' %>" required placeholder="you@example.com"></div><div class="col-12"><label class="form-label" for="subject">Subject</label><input class="form-control" id="subject" name="subject" value="<%= formData.subject || '' %>" placeholder="How can we help?"></div><div class="col-12"><label class="form-label" for="message">Your message *</label><textarea class="form-control" id="message" name="message" rows="5" required minlength="10" placeholder="Write your message..."><%= formData.message || '' %></textarea></div><div class="col-12"><button class="btn btn-primary rounded-pill px-4" type="submit">Send message <i class="bi bi-arrow-right ms-2"></i></button></div></div></form></div></div></div></div></main>
<%- include("../partials/footer") %><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="/js/main.js"></script></body></html>