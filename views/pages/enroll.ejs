<%- include("../partials/head", { title }) %><%- include("../partials/navbar") %>
<main class="form-page"><div class="container"><div class="row align-items-center g-5"><div class="col-lg-5 reveal enroll-visual-column">
  <span class="eyebrow"><i class="bi bi-stars"></i> Start your learning journey</span>
  <h1 class="form-title">Enroll in your<br><span>dream course.</span></h1>
  <p class="muted-copy">Take the first step toward a successful career. Fill in your details and join a community of learners.</p>
  <div class="enroll-benefits">
    <div class="enroll-benefit"><i class="bi bi-lightning-charge-fill"></i><span><b>Flexible learning</b><small>Learn at your own pace</small></span></div>
    <div class="enroll-benefit"><i class="bi bi-person-video3"></i><span><b>Expert mentors</b><small>Get guidance from professionals</small></span></div>
    <div class="enroll-benefit"><i class="bi bi-patch-check-fill"></i><span><b>Career-ready skills</b><small>Build projects and showcase your work</small></span></div>
  </div>
  <div class="enroll-computer-scene" aria-label="Animated illustration of a computer for online learning">
    <span class="computer-orbit orbit-a"></span><span class="computer-orbit orbit-b"></span>
    <div class="computer-float-icon icon-code"><i class="bi bi-code-slash"></i></div>
    <div class="computer-float-icon icon-cap"><i class="bi bi-mortarboard-fill"></i></div>
    <div class="computer-float-icon icon-star"><i class="bi bi-stars"></i></div>
    <div class="desktop-monitor"><div class="monitor-camera"></div><div class="monitor-screen"><div class="screen-top"><i></i><i></i><i></i><span>cognifyz.learn()</span></div><div class="screen-code"><b>Learn. Build. Grow.</b><span class="code-line line-one"></span><span class="code-line line-two"></span><span class="code-line line-three"></span><div class="screen-play"><i class="bi bi-play-fill"></i></div></div></div><div class="monitor-neck"></div><div class="monitor-base"></div></div>
    <div class="floating-progress"><i class="bi bi-graph-up-arrow"></i><span><b>Keep growing</b><small>One skill at a time</small></span></div>
  </div>
</div>
<div class="col-lg-7 reveal"><div class="form-card"><span class="eyebrow">Course enrollment</span><h2>Tell us about yourself</h2><p class="muted-copy">Fields marked * are required.</p>
<% if (success) { %><div class="alert alert-success">Your demo enrollment was submitted successfully!</div><% } %><% if (errors.length) { %><div class="alert alert-danger"><ul class="mb-0"><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %>
<form action="/enroll" method="POST" id="enrollForm" class="needs-validation" novalidate><div class="row g-3">
<div class="col-md-6"><label class="form-label" for="fullName">Full name *</label><input class="form-control" id="fullName" name="fullName" value="<%= formData.fullName || '' %>" required minlength="2" placeholder="Your full name"><div class="invalid-feedback">Please enter your name.</div></div>
<div class="col-md-6"><label class="form-label" for="email">Email address *</label><input class="form-control" type="email" id="email" name="email" value="<%= formData.email || '' %>" required placeholder="you@example.com"><div class="invalid-feedback">Enter a valid email.</div></div>
<div class="col-md-6"><label class="form-label" for="phone">Phone number *</label><input class="form-control" id="phone" name="phone" value="<%= formData.phone || '' %>" required pattern="[0-9+\-\s]{10,15}" placeholder="+91 98765 43210"><div class="invalid-feedback">Enter a valid phone number.</div></div>
<div class="col-md-6"><label class="form-label" for="dob">Date of birth *</label><input class="form-control" type="date" id="dob" name="dob" value="<%= formData.dob || '' %>" required><div class="invalid-feedback">Choose a past date.</div></div>
<div class="col-md-6"><label class="form-label" for="course">Select course *</label><select class="form-select" id="course" name="course" required><option value="">Choose a course</option><% ["Full Stack Web Development","Java Programming","Python for Data Science","Generative AI & Machine Learning","UI/UX Design Fundamentals","Data Analytics Essentials"].forEach(c => { %><option <%= formData.course === c ? "selected" : "" %>><%= c %></option><% }) %></select></div>
<div class="col-md-6"><label class="form-label" for="learningMode">Learning mode *</label><select class="form-select" id="learningMode" name="learningMode" required><option value="">Choose a mode</option><option <%= formData.learningMode === "Online" ? "selected" : "" %>>Online</option><option <%= formData.learningMode === "Self-paced" ? "selected" : "" %>>Self-paced</option></select></div>
<div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" id="terms" required><label class="form-check-label" for="terms">I agree to be contacted about this course.</label></div></div>
<div class="col-12"><button class="btn btn-primary rounded-pill w-100 btn-lg" type="submit">Submit enrollment <i class="bi bi-arrow-right ms-2"></i></button></div></div></form><p class="form-foot"><i class="bi bi-shield-check"></i> Demo form: information is not stored permanently.</p></div></div></div></div></main>
<%- include("../partials/footer") %><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="/js/main.js"></script></body></html>