<div class="col-12 col-sm-6 col-xl-3 course-item" data-category="<%= category %>">
  <article class="course-card h-100 reveal">
    <div class="course-card-head">
      <span class="course-icon <%= color %>"><i class="bi <%= icon %>"></i></span>
      <span class="course-arrow"><i class="bi bi-arrow-up-right"></i></span>
    </div>
    <h3><%= name %></h3>
    <p><%= description %></p>
    <div class="course-meta">
      <span class="course-rating"><i class="bi bi-star-fill"></i> <b><%= rating %></b> <small>(<%= learners %>)</small></span>
      <span class="course-enrolled"><%= enrolled %></span>
    </div>
  </article>
</div>